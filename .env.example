API_ID=12345678
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# ── tempmail.id.vn 附加域名来源（可选）────────────────────────────
# 账号级 API key，按 slot 编号排列。全部留空则整个来源自动隐藏，
# bot 的 /tmail vn 和网页的来源切换都不会出现。
#
# 多 key 的作用是分摊「读信额度」和「邮箱数量上限」：
#   - 建号时轮流分配到不同 key，满了就删该账号下最旧的邮箱腾位置
#   - 读信必须用建号时那个 key，所以 slot 会跟着邮箱记录
#
# 免费版每个账号：900 次读/月、20 次/分、50 个邮箱。
# 网页端不轮询（额度撑不住），只能手动刷新。
TEMPMAIL_EDU_API_KEY_0=
TEMPMAIL_EDU_API_KEY_1=
TEMPMAIL_EDU_API_KEY_2=
TEMPMAIL_EDU_API_KEY_3=

# 每个账号最多保留多少个邮箱，留 1 个余量避免卡在上限建号失败。
# 不填默认 49；免费版上限是 50。
TEMPMAIL_EDU_MAILBOX_LIMIT=49

# vnproxy 监听地址（仅容器/本机，由外层反代转发）
VNPROXY_PORT=8091
VNPROXY_HOST=0.0.0.0
