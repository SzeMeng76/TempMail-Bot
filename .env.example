API_ID=12345678
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# ── tempmail.id.vn 附加域名来源（可选）────────────────────────────
# 账号级 API key，按 slot 编号排列。全部留空则整个来源自动隐藏，
# bot 的 /tmail vn 和网页的来源切换都不会出现。
#
# 多 key 的作用是分摊「读信额度」和「邮箱数量上限」：
#   - 建号时轮流分配到不同 key，满了就删该账号下最旧的邮箱腾位置
#   - 读信必须用建号时那个 key，所以 slot 会跟着邮箱记录
#
# 免费版每个账号：900 次读/月、20 次/分、50 个邮箱。
# 网页端不轮询（额度撑不住），只能手动刷新。
TEMPMAIL_EDU_API_KEY_0=
TEMPMAIL_EDU_API_KEY_1=
TEMPMAIL_EDU_API_KEY_2=
TEMPMAIL_EDU_API_KEY_3=

# 每个账号最多保留多少个邮箱，留 1 个余量避免卡在上限建号失败。
# 不填默认 49；免费版上限是 50。
TEMPMAIL_EDU_MAILBOX_LIMIT=49

# ── luuvan.site 来源（可选，但强烈建议配）──────────────────────────
# 这个来源的特点是「地址本身就是读信凭证」：服务端是域名级 catch-all，
# 收信按收件地址落库，读信接口完全匿名，不需要事先建号。
# 所以它特别适合发卡密 —— 卡密里直接写 xxx@n0ai.cloud，买家拿到就能读。
#
# 不配 key 也能用：
#   - 建号只能走游客接口，5 个/天/IP，且 24 小时后过期
#   - 读信完全不受影响（读信本来就不需要 key）
#
# 配了 key 之后：
#   - 建号的邮箱是永久的（expiresAt 是一百年后）
#   - 建号额度 100 次/小时
#
# key 是账号级凭证，和 TEMPMAIL_EDU_API_KEY 一样绝不能给前端。
# 网页端建号一律经过 vnproxy 中转。
#
# 获取方式：登录 luuvan.site → 打开 Dashboard → 创建 API key，
# 或已登录时直接 POST /api/register {"name":"YourApp"}。
LUUVAN_API_KEY=
# 上游地址，一般不用改
LUUVAN_BASE_URL=https://luuvan.site

# vnproxy 监听地址（仅容器/本机，由外层反代转发）
VNPROXY_PORT=8091
VNPROXY_HOST=0.0.0.0
